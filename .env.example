# Copy this file to .env for local development and add real secrets only to .env.
# Never commit an actual API key or provider credential.

APP_ENV=development
NEWS_SOURCE_MODE=fixture

# Backend-only secrets. Replace these values only in your ignored .env file.
DATABASE_URL=postgresql://your_local_user:your_local_password@localhost:5432/newsflow
DATABASE_CONNECT_TIMEOUT_SECONDS=5
OPENAI_API_KEY=your_openai_api_key_here

# This value is exposed to browser code, so it must never contain a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

