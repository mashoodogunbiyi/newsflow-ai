# Copy this file to .env for local development and add real secrets only to .env.
# Never commit an actual API key or provider credential.

APP_ENV=development
NEWS_SOURCE_MODE=fixture
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# PostgreSQL creates the local Docker database from these values.
POSTGRES_USER=your_local_user
POSTGRES_PASSWORD=your_local_password
POSTGRES_DB=newsflow

# Backend-only secrets. Replace these values only in your ignored .env file.
# This URL is for running FastAPI directly on the host. Docker Compose creates
# a container-only URL with the database service hostname.
DATABASE_URL=postgresql://your_local_user:your_local_password@localhost:5432/newsflow
DATABASE_CONNECT_TIMEOUT_SECONDS=5
REGISTRATION_RATE_LIMIT_ATTEMPTS=5
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
SESSION_LIFETIME_MINUTES=60
OPENAI_API_KEY=your_openai_api_key_here

# Seed loading requires an explicit one-command override. Keep this false normally.
SEED_DATA_ENABLED=false

# This value is exposed to browser code, so it must never contain a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Next.js uses this server-only address to reach FastAPI. Docker Compose sets
# it to http://backend:8000 automatically. Keep localhost for manual setup.
API_INTERNAL_BASE_URL=http://localhost:8000

